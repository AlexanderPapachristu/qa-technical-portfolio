# Copy this file to .env and fill in the passwords. Never commit .env.
# Local Docker instance (npm run vikunja:up). Use https://try.vikunja.io to test the public demo instead.
VIKUNJA_URL=http://localhost:3456
OWNER_USER=User-Owner
OWNER_PASS=
READ_USER=User-Read
READ_PASS=
PROJECT_TITLE=RBAC Test Project
WRITE_USER=User-Write
WRITE_PASS=
UNRELATED_USER=User-Unrelated
UNRELATED_PASS=
SHAREADMIN_USER=User-ShareAdmin
SHAREADMIN_PASS=
TEAM_USER=User-Team
TEAM_PASS=
# Account used by the task-lifecycle specs (tests/helpers/task-helpers.ts)
TASK_USER=test_account
TASK_PASS=
