{
  "name": "02-vikunja-saas-task-manager",
  "version": "1.0.0",
  "description": "- **Application:** Vikunja  \r - **Environment:** http://localhost:3456 (Docker), https://try.vikunja.io/\r - **Browser:** Chrome",
  "main": "index.js",
  "scripts": {
    "test:ui": "playwright test --project=rbac-chromium --project=rbac-firefox --project=rbac-webkit",
    "test:tasks": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:api": "node scripts/run-newman.js",
    "test:all": "playwright test && node scripts/run-newman.js",
    "vikunja:up": "docker compose up -d && node scripts/seed-accounts.js",
    "vikunja:seed": "node scripts/seed-accounts.js",
    "vikunja:down": "docker compose stop",
    "vikunja:reset": "docker compose down -v",
    "vikunja:clean": "node scripts/cleanup-test-data.js",
    "vikunja:logs": "docker compose logs -f vikunja"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "dotenv": "^16.4.5",
    "newman": "^6.2.1"
  }
}
