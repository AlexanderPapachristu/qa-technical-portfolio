  "item": [
    {
      "name": "Server Info / Security Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"API version info is returned\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData).to.have.property(\"version\");\r\n    pm.expect(jsonData).to.have.property(\"frontend_url\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://try.vikunja.io/api/v1/info",
          "protocol": "https",
          "host": [
            "try",
            "vikunja",
            "io"
          ],
          "path": [
            "api",
            "v1",
            "info"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Negative Security Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns 401 Unauthorized when requesting projects without token\", function () {\r\n    pm.response.to.have.status(401);\r\n});\r\n\r\npm.test(\"Error message structure is valid\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData).to.have.property(\"message\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://try.vikunja.io/api/v1/projects",
          "protocol": "https",
          "host": [
            "try",
            "vikunja",
            "io"
          ],
          "path": [
            "api",
            "v1",
            "projects"
          ]
        }
      },
      "response": []
    }
  ]
